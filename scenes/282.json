{"turns":[{"text":"I really owe you one.","zh":"我真的欠你一个人情。","start":1091.0066666666667,"end":1092.08},{"text":"No problem at all, Tom.","zh":"完全没问题，汤姆。","start":1093.090625,"end":1093.8125000000002},{"text":"Have fun at the wedding.","zh":"婚礼上玩得开心点。","start":1093.8125,"end":1098.71},{"text":"See how Sarah was so smart?","zh":"你看莎拉多聪明啊？","start":1099.21,"end":1102.16},{"text":"She didn't just say yes to Tom's favor.","zh":"她没有直接答应帮汤姆的忙。","start":1103.8353333333334,"end":1105.76},{"text":"She made a deal with him.","zh":"她跟他谈了个条件。","start":1107.0773333333334,"end":1108.0653333333332},{"text":"She negotiated.","zh":"她谈了条件。","start":1108.0653333333335,"end":1110},{"text":"Yes, she did.","zh":"是的，她确实谈了。","start":1110.39,"end":1111.5600000000002}],"lessonTurns":[{"text":"I really owe you one.","zh":"我真的欠你一个人情。","start":1091.0066666666667,"end":1092.08},{"text":"No problem at all, Tom.","zh":"完全没问题，汤姆。","start":1093.090625,"end":1093.8125000000002},{"text":"Have fun at the wedding.","zh":"婚礼上玩得开心点。","start":1093.8125,"end":1098.71},{"text":"See how Sarah was so smart?","zh":"你看莎拉多聪明啊？","start":1099.21,"end":1102.16},{"text":"She didn't just say yes to Tom's favor.","zh":"她没有直接答应帮汤姆的忙。","start":1103.8353333333334,"end":1105.76},{"text":"She made a deal with him.","zh":"她跟他谈了个条件。","start":1107.0773333333334,"end":1108.0653333333332},{"text":"She negotiated.","zh":"她谈了条件。","start":1108.0653333333335,"end":1110},{"text":"Yes, she did.","zh":"是的，她确实谈了。","start":1110.39,"end":1111.5600000000002}]}