{"turns":[{"text":"All right, let's listen to Sarah and David.","zh":"好了，我们听听莎拉和大卫怎么说。","start":162.0025,"end":165.599},{"text":"Hi, you must be David, the new guy in the creative team.","zh":"嗨，你一定是大卫吧，创意团队的新人。","start":165.87,"end":169.9758},{"text":"I'm Sarah from marketing.","zh":"我是市场部的莎拉。","start":169.9758,"end":171.6541666666667},{"text":"Mind if I sit here?","zh":"介意我坐这儿吗？","start":171.65416666666667,"end":172.56},{"text":"Oh, hey Sarah.","zh":"哦，嘿，莎拉。","start":173.995,"end":174.61},{"text":"Yeah, that's me.","zh":"对，就是我。","start":174.61,"end":175.22500000000002},{"text":"Of course.","zh":"当然不介意。","start":175.225,"end":176.922},{"text":"Sit down.","zh":"坐吧。","start":176.922,"end":177.25133333333335}],"lessonTurns":[{"text":"All right, let's listen to Sarah and David.","zh":"好了，我们听听莎拉和大卫怎么说。","start":162.0025,"end":165.599},{"text":"Hi, you must be David, the new guy in the creative team.","zh":"嗨，你一定是大卫吧，创意团队的新人。","start":165.87,"end":169.9758},{"text":"I'm Sarah from marketing.","zh":"我是市场部的莎拉。","start":169.9758,"end":171.6541666666667},{"text":"Mind if I sit here?","zh":"介意我坐这儿吗？","start":171.65416666666667,"end":172.56},{"text":"Oh, hey Sarah.","zh":"哦，嘿，莎拉。","start":173.995,"end":174.61},{"text":"Yeah, that's me.","zh":"对，就是我。","start":174.61,"end":175.22500000000002},{"text":"Of course.","zh":"当然不介意。","start":175.225,"end":176.922},{"text":"Sit down.","zh":"坐吧。","start":176.922,"end":177.25133333333335}]}