{"turns":[{"text":"That sounds like a ‘the 1975’ album.","zh":"那听起来像 The 1975 乐队的一张专辑名。","start":924.8433333333334,"end":925.8085714285713},{"text":"It does yeah.","zh":"确实像，是啊。","start":925.92,"end":926.2542857142856},{"text":"Dig deep, dig dig dig.","zh":"再挖深一点，挖挖挖。","start":926.3657142857143,"end":926.9228571428571},{"text":"What’s the next one?","zh":"下一个是什么？","start":927.0342857142857,"end":927.48},{"text":"Should we have one more question?","zh":"我们要不要再问一个问题？","start":927.48,"end":929.8061538461538},{"text":"I don't know how long we've been talking for.","zh":"我都不知道我们聊了多久了。","start":929.8061538461538,"end":932.9505882352942},{"text":"I don't know either.","zh":"我也不知道。","start":933.1658823529411,"end":934.0270588235294},{"text":"Let's do two more.","zh":"那就再来两个吧。","start":934.0270588235294,"end":934.8882352941176}],"lessonTurns":[{"text":"That sounds like a ‘the 1975’ album.","zh":"那听起来像 The 1975 乐队的一张专辑名。","start":924.8433333333334,"end":925.8085714285713},{"text":"It does yeah.","zh":"确实像，是啊。","start":925.92,"end":926.2542857142856},{"text":"Dig deep, dig dig dig.","zh":"再挖深一点，挖挖挖。","start":926.3657142857143,"end":926.9228571428571},{"text":"What’s the next one?","zh":"下一个是什么？","start":927.0342857142857,"end":927.48},{"text":"Should we have one more question?","zh":"我们要不要再问一个问题？","start":927.48,"end":929.8061538461538},{"text":"I don't know how long we've been talking for.","zh":"我都不知道我们聊了多久了。","start":929.8061538461538,"end":932.9505882352942},{"text":"I don't know either.","zh":"我也不知道。","start":933.1658823529411,"end":934.0270588235294},{"text":"Let's do two more.","zh":"那就再来两个吧。","start":934.0270588235294,"end":934.8882352941176}]}