{"turns":[{"text":"You have to decline.","zh":"你得拒绝他。","start":663.521,"end":666.9964705882353},{"text":"It's not easy to say no, right?","zh":"说「不」不容易吧？","start":666.9964705882353,"end":668.88},{"text":"You don't want to be rude.","zh":"你不想显得没礼貌。","start":670.0799999999999,"end":670.9799999999999},{"text":"You want to be polite.","zh":"你想客气一点。","start":670.9799999999999,"end":673.92},{"text":"So, let's first listen to this conversation and see how it goes.","zh":"那我们先听听这段对话，看看是怎么回事。","start":674.4572499999999,"end":681.509},{"text":"Hey, Tom.","zh":"嘿，Tom。","start":681.847875,"end":682.505625},{"text":"Do you have a minute?","zh":"你有空吗？","start":682.505625,"end":684.16},{"text":"Yeah, sure.","zh":"嗯，当然。","start":685.7592307692307,"end":686.1146153846154}],"lessonTurns":[{"text":"You have to decline.","zh":"你得拒绝他。","start":663.521,"end":666.9964705882353},{"text":"It's not easy to say no, right?","zh":"说「不」不容易吧？","start":666.9964705882353,"end":668.88},{"text":"You don't want to be rude.","zh":"你不想显得没礼貌。","start":670.0799999999999,"end":670.9799999999999},{"text":"You want to be polite.","zh":"你想客气一点。","start":670.9799999999999,"end":673.92},{"text":"So, let's first listen to this conversation and see how it goes.","zh":"那我们先听听这段对话，看看是怎么回事。","start":674.4572499999999,"end":681.509},{"text":"Hey, Tom.","zh":"嘿，Tom。","start":681.847875,"end":682.505625},{"text":"Do you have a minute?","zh":"你有空吗？","start":682.505625,"end":684.16},{"text":"Yeah, sure.","zh":"嗯，当然。","start":685.7592307692307,"end":686.1146153846154}]}