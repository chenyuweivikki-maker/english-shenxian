{"turns":[{"text":"Completely dead.","zh":"彻底没电了。","start":129.994,"end":130.28971428571427},{"text":"And I really need to make a call.","zh":"而且我真的得打个电话。","start":130.2897142857143,"end":132.72},{"text":"Oh, that's not good.","zh":"哦，那可不妙。","start":133.40584615384617,"end":134.0916923076923},{"text":"Who do you need to call?","zh":"你要打给谁啊？","start":134.0916923076923,"end":135.76},{"text":"I need to call my mom.","zh":"我得打给我妈。","start":136.13636363636363,"end":137.26545454545456},{"text":"She's waiting for me.","zh":"她还在等我呢。","start":137.26545454545456,"end":139.40894736842105},{"text":"And I can't tell her I'll be late.","zh":"而且我没法跟她说我会迟到。","start":139.40894736842105,"end":140.56},{"text":"Oh, I see.","zh":"哦，我明白了。","start":141.41384615384615,"end":141.68}],"lessonTurns":[{"text":"Completely dead.","zh":"彻底没电了。","start":129.994,"end":130.28971428571427},{"text":"And I really need to make a call.","zh":"而且我真的得打个电话。","start":130.2897142857143,"end":132.72},{"text":"Oh, that's not good.","zh":"哦，那可不妙。","start":133.40584615384617,"end":134.0916923076923},{"text":"Who do you need to call?","zh":"你要打给谁啊？","start":134.0916923076923,"end":135.76},{"text":"I need to call my mom.","zh":"我得打给我妈。","start":136.13636363636363,"end":137.26545454545456},{"text":"She's waiting for me.","zh":"她还在等我呢。","start":137.26545454545456,"end":139.40894736842105},{"text":"And I can't tell her I'll be late.","zh":"而且我没法跟她说我会迟到。","start":139.40894736842105,"end":140.56},{"text":"Oh, I see.","zh":"哦，我明白了。","start":141.41384615384615,"end":141.68}]}