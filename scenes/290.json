{"turns":[{"text":"Oh, yeah.","zh":"哦，对。","start":125.1095,"end":125.592},{"text":"You could say that.","zh":"可以这么说吧。","start":126.702,"end":128.192},{"text":"That's the A1 model.","zh":"那是A1型号。","start":129.35311111111113,"end":130.292},{"text":"There's not much change from the original.","zh":"跟原版比没什么大改动。","start":131.10563636363636,"end":133.892},{"text":"Biggest difference is the stock.","zh":"最大的区别是枪托。","start":134.22366666666667,"end":135.892},{"text":"It's fiberglass instead of wood.","zh":"是玻璃纤维的，不是木头的。","start":136.887,"end":137.892},{"text":"They changed it over in 1970 or so.","zh":"大概是1970年前后改的。","start":138.88815384615384,"end":140.492},{"text":"Good.","zh":"好。","start":141.743,"end":141.892}],"lessonTurns":[{"text":"Oh, yeah.","zh":"哦，对。","start":125.1095,"end":125.592},{"text":"You could say that.","zh":"可以这么说吧。","start":126.702,"end":128.192},{"text":"That's the A1 model.","zh":"那是A1型号。","start":129.35311111111113,"end":130.292},{"text":"There's not much change from the original.","zh":"跟原版比没什么大改动。","start":131.10563636363636,"end":133.892},{"text":"Biggest difference is the stock.","zh":"最大的区别是枪托。","start":134.22366666666667,"end":135.892},{"text":"It's fiberglass instead of wood.","zh":"是玻璃纤维的，不是木头的。","start":136.887,"end":137.892},{"text":"They changed it over in 1970 or so.","zh":"大概是1970年前后改的。","start":138.88815384615384,"end":140.492},{"text":"Good.","zh":"好。","start":141.743,"end":141.892}]}